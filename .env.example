# ChatWork 通知（tools/chatwork_notify.py・Make）の設定例。
# このファイルを .env にコピーして値を入れる。.env は .gitignore 済みで、リポジトリには入らない。
CHATWORK_API_TOKEN=
CHATWORK_ROOM_ID=363171715

# SNS 自動投稿（GitHub Actions では同じ名前で Secrets に登録する）
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=
WORDPRESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
PINTEREST_APP_ID=
PINTEREST_ACCESS_TOKEN=

# 配信管理表の読み書き（サービスアカウントのJSON全文を1行で。GitHub では Secrets に登録）
GOOGLE_SERVICE_ACCOUNT_JSON=
# tools/get_tokens.py のリダイレクトURI（省略時 http://localhost:8080/callback）
# OAUTH_REDIRECT_URI=
