{
  "name": "01 投稿キュー（Threads / LinkedIn / TikTok / Shorts / Instagram / Pinterest / note）",
  "flow": [
    {
      "id": 1,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "authenticationType": "noAuth"
      },
      "mapper": {
        "url": "https://raw.githubusercontent.com/kiichi4268/-ai_employees-/main/content/2026-10/auto_posts.json",
        "method": "get",
        "queryParameters": [
          {
            "name": "t",
            "value": "{{formatDate(now; \"x\")}}"
          }
        ],
        "headers": [
          {
            "name": "Cache-Control",
            "value": "no-cache"
          }
        ],
        "parseResponse": true
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "note": "キャッシュ回避のため ?t=<ミリ秒> を毎回付ける"
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "mapper": {
        "array": "{{1.data}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "routes": [
        {
          "flow": [
            {
              "id": 10,
              "module": "google-sheets:updateRow",
              "version": 2,
              "parameters": {
                "__IMTCONN__": null
              },
              "mapper": {
                "mode": "map",
                "spreadsheetId": "1m7VCzodX8U3xzuTzFYOXQX8IWfExvXXvo6T3Xq3Gstk",
                "sheetId": "配信管理表",
                "rowNumber": "{{2.sheet_row}}",
                "tableFirstRow": "A1:Z1",
                "values": {
                  "3": "module_missing",
                  "4": "",
                  "5": "Threads：この前に Zernio「Add a Threads Post」(make-nodes-late:addThreadsPost) を追加し、成功時は status=posted・posted_at={{now}}・log=投稿URL にする"
                }
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": 0
                }
              },
              "filter": {
                "name": "platform = threads・ready・予定時刻が直近15分以内",
                "conditions": [
                  [
                    {
                      "a": "{{2.status}}",
                      "o": "text:equal",
                      "b": "ready"
                    },
                    {
                      "a": "{{2.scheduled_at}}",
                      "o": "date:lessorequal",
                      "b": "{{now}}"
                    },
                    {
                      "a": "{{2.scheduled_at}}",
                      "o": "date:greater",
                      "b": "{{addMinutes(now; -15)}}"
                    },
                    {
                      "a": "{{2.platform}}",
                      "o": "text:equal",
                      "b": "threads"
                    }
                  ]
                ]
              }
            }
          ]
