{
  "name": "04 WordPress 記事の予約投稿",
  "flow": [
    {
      "id": 1,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "authenticationType": "noAuth"
      },
      "mapper": {
        "url": "https://raw.githubusercontent.com/kiichi4268/-ai_employees-/main/content/2026-10/wordpress_posts.json",
        "method": "get",
        "queryParameters": [
          {
            "name": "t",
            "value": "{{formatDate(now; \"x\")}}"
          }
        ],
        "headers": [
          {
            "name": "Cache-Control",
            "value": "no-cache"
          }
        ],
        "parseResponse": true
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "note": "キャッシュ回避のため ?t=<ミリ秒> を毎回付ける"
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "mapper": {
        "array": "{{1.data}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "authenticationType": "oAuth",
        "oAuthAccount": null
      },
      "mapper": {
        "url": "{{2.endpoint}}",
        "method": "post",
        "contentType": "urlEncoded",
        "urlEncodedBodyContent": [
          {
            "name": "title",
            "value": "{{2.title}}"
          },
          {
            "name": "content",
            "value": "{{2.content_html}}"
          },
          {
            "name": "excerpt",
            "value": "{{2.excerpt}}"
          },
          {
            "name": "slug",
            "value": "{{2.slug}}"
          },
          {
            "name": "status",
            "value": "{{2.wp_status}}"
          },
          {
            "name": "date",
            "value": "{{2.scheduled_at}}"
          }
        ],
        "parseResponse": true
      },
      "filter": {
        "name": "ready かつ 予定時刻が直近15分以内",
        "conditions": [
          [
            {
              "a": "{{2.status}}",
              "o": "text:equal",
              "b": "ready"
            },
            {
              "a": "{{2.scheduled_at}}",
              "o": "date:lessorequal",
              "b": "{{now}}"
            },
            {
              "a": "{{2.scheduled_at}}",
              "o": "date:greater",
              "b": "{{addMinutes(now; -15)}}"
            }
          ]
        ]
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "note": "接続は WordPress.com の OAuth2（public-api.wordpress.com）。categories・tags は名前で入っているので、使う場合はIDに変換してから送る"
      },
      "onerror": [
        {
          "id": 30,
          "module": "http:MakeRequest",
          "version": 4,
          "parameters": {
            "authenticationType": "apiKeyConnection",
            "apiKeyAccount": null
          },
          "mapper": {
            "url": "https://api.chatwork.com/v2/rooms/363171715/messages",
            "method": "post",
            "contentType": "urlEncoded",
            "urlEncodedBodyContent": [
              {
                "name": "body",
                "value": "[info][title]【投稿失敗】WordPress {{2.scheduled_at}}（{{2.id}}）[/title]■ エラー：HTTP {{3.statusCode}} {{3.data.message}}\n■ 次の対応：WordPress.com の接続（OAuth2）と記事の内容を確認して再送する[/info]"
              }
            ],
            "parseResponse": true
          },
          "metadata": {
            "designer": {
              "x": 600,
              "y": 0
            },
            "note": "接続は「HTTP ➔ API key」：ヘッダー名 X-ChatWorkToken、値に .env の CHATWORK_API_TOKEN"
          }
        },
        {
          "id": 31,
          "module": "google-sheets:updateRow",
          "version": 2,
          "parameters": {
            "__IMTCONN__": null
          },
          "mapper": {
            "mode": "map",
            "spreadsheetId": "1m7VCzodX8U3xzuTzFYOXQX8IWfExvXXvo6T3Xq3Gstk",
            "sheetId": "配信管理表",
            "rowNumber": "{{2.sheet_row}}",
            "tableFirstRow": "A1:Z1",
            "values": {
              "3": "failed",
              "4": "",
              "5": "HTTP {{3.statusCode}} {{3.data.message}}"
            }
          },
          "metadata": {
            "designer": {
              "x": 900,
              "y": 0
            }
          }
        },
        {
          "id": 32,
          "module": "builtin:Ignore",
          "version": 1,
          "metadata": {
            "designer": {
              "x": 1200,
              "y": 150
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "mode": "map",
        "spreadsheetId": "1m7VCzodX8U3xzuTzFYOXQX8IWfExvXXvo6T3Xq3Gstk",
        "sheetId": "配信管理表",
        "rowNumber": "{{2.sheet_row}}",
        "tableFirstRow": "A1:Z1",
        "values": {
          "3": "posted",
          "4": "{{now}}",
          "5": "{{3.data.link}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "version": 1,
    "instant": false,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "sequential": true
    }
  }
}
